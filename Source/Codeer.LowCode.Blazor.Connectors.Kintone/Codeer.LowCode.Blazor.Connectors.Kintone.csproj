<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Version>0.1.0</Version>
		<Authors>Codeer</Authors>
		<Company>Codeer</Company>
		<Description>Client-side fields for Codeer.LowCode.Blazor.Connectors.Kintone. Includes the kintone attachments field, which lists, downloads, adds and deletes the files of a kintone attachment (FILE) field.</Description>
		<PackageProjectUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Connectors.Kintone</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Connectors.Kintone</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Blazor;LowCode;Codeer;kintone;Cybozu;Connector</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>Initial release.</PackageReleaseNotes>
		<PackageId>Codeer.LowCode.Blazor.Connectors.Kintone</PackageId>
	</PropertyGroup>

	<ItemGroup>
		<!-- テストだけに internal を見せる (製品アセンブリへの IVT は出さない) -->
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Codeer.LowCode.Blazor.Connectors.Kintone.Test</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Codeer.LowCode.Blazor" Version="1.3.70" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
