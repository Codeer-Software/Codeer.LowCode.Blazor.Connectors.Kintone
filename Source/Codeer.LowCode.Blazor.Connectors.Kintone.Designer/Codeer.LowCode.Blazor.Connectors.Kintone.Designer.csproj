<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Version>0.1.0</Version>
		<Authors>Codeer</Authors>
		<Company>Codeer</Company>
		<Description>Designer support for Codeer.LowCode.Blazor.Connectors.Kintone.Server. Registers the specification document that AI assistants read when designing modules bound to kintone apps, adds a menu that updates the kintone metadata file, and puts the kintone attachments field in the toolbox.</Description>
		<PackageProjectUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Connectors.Kintone</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Connectors.Kintone</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Blazor;LowCode;Codeer;kintone;Cybozu;Designer</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>Initial release.</PackageReleaseNotes>
		<PackageId>Codeer.LowCode.Blazor.Connectors.Kintone.Designer</PackageId>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Codeer.LowCode.Blazor" Version="1.3.70" />
		<PackageReference Include="Codeer.LowCode.Blazor.Designer" Version="1.3.71" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Codeer.LowCode.Blazor.Connectors.Kintone.Server\Codeer.LowCode.Blazor.Connectors.Kintone.Server.csproj" />
		<ProjectReference Include="..\Codeer.LowCode.Blazor.Connectors.Kintone\Codeer.LowCode.Blazor.Connectors.Kintone.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- AI 用の仕様ドキュメント。SpecDocCatalog に登録して ai-refresh が _specs/<名前>.md に書き出す -->
	<ItemGroup>
		<None Remove="SpecDocs\**\*.md" />
		<EmbeddedResource Include="SpecDocs\**\*.md">
			<LogicalName>Codeer.LowCode.Blazor.Connectors.Kintone.Designer.SpecDocs.%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

</Project>
